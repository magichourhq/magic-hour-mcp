MAGIC_HOUR_API_KEY=mhk_live_your_key_here

# PostHog analytics configuration
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://us.i.posthog.com

# This doesn't do anything, but it's nice to have your key available to paste

# Required in production when this app is behind a proxy or mounted below root.
# MCP_OAUTH_ISSUER_URL=https://mcp.magichour.ai
# MCP_OAUTH_RESOURCE_URL=https://mcp.magichour.ai

# Video production and media tools. On Vercel or more than one instance, set both Blob tokens.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_public_store_token
# KEPT_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_private_store_token
# MAGIC_HOUR_MCP_PUBLIC_URL=https://your-server.example.com
# Sends the narration audio to OpenAI Whisper to check its words (off by default).
# MAGIC_HOUR_TRANSCRIBE_CHECK=on
# OPENAI_API_KEY=sk-your_openai_key_here
